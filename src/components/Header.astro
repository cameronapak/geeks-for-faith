---
import ThemeToggle from "./ThemeToggle.astro";
import ExternalLink from "./icons/ExternalLink.astro";
---

<header class="mb-6 flex items-center justify-between" transition:name="header">
  <nav class="flex items-center gap-4">
    <a href="/"> home </a>
    <a href="/faith-tech-communities"> groups </a>
    <a title="Visit faith.tools" target="_blank" href="https://faith.tools">
      apps <ExternalLink className="h-3 w-3" />
    </a>
    <a
      target="_blank"
      href="https://christiantechjobs.io"
      title="Visit Christian Tech Jobs"
    >
      jobs <ExternalLink className="h-3 w-3" />
    </a>
    <a target="_blank" href="https://letterbird.co/cameronandrewpak">
      contact <ExternalLink className="h-3 w-3" />
    </a>
  </nav>
  <ThemeToggle />
</header>

<style>
  a {
    @apply font-medium text-zinc-500 hover:text-zinc-900 hover:underline dark:hover:text-zinc-100;
  }

  a[target="_blank"] {
    @apply flex items-center gap-1;
  }
</style>
