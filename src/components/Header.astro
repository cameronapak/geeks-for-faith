---
import ThemeToggle from "./ThemeToggle.astro";
import ExternalLink from "./icons/ExternalLink.astro";
---

<header class="mb-6 flex items-center justify-between" transition:name="header">
  <nav class="flex items-center gap-4">
    <a href="/"> home </a>
    <a href="/faith-tech-communities"> communities </a>
    <a
      class="flex items-center gap-1"
      target="_blank"
      href="https://faith.tools"
    >
      faith.tools <ExternalLink className="h-3 w-3" />
    </a>
    <a target="_blank" href="https://letterbird.co/cameronandrewpak">contact</a>
  </nav>
  <ThemeToggle />
</header>

<style>
  a {
    @apply font-medium text-zinc-500 hover:text-zinc-900 hover:underline dark:hover:text-zinc-100;
  }
</style>
