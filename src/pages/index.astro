---
import { getCollection } from "astro:content";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Layout from "../layouts/Layout.astro";
import { FAITH_TECH_COMMUNITIES, formatDate } from "../lib/utils";
const collection = await getCollection("posts");
const posts = collection.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const communityCount = FAITH_TECH_COMMUNITIES.length;
const communityFaces = [
  "https://faithtech.com",
  "https://churchitnetwork.com",
  "https://chaiglobal.ai",
  "https://kingdomcode.org.uk",
  "https://www.christiantechcommunity.org/",
];
---

<Layout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  className="flex h-svh w-full max-w-xl flex-col justify-start"
>
  <main class="w-full space-y-4">
    <h1 class="text-2xl font-medium">Geeks for Faith</h1>
    <p class="text-zinc-500">
      May this be a place where we can share our faith, our tech, and learn from
      one another.
    </p>
    <a
      href="/faith-tech-communities"
      class="mesh-night group relative block overflow-hidden rounded-2xl p-6 text-white shadow-sm transition-shadow hover:shadow-xl"
    >
      <div class="flex items-center gap-3">
        <div class="flex -space-x-1.5">
          {
            communityFaces.map((url) => (
              <img
                src={`https://www.google.com/s2/favicons?sz=64&domain=${url}`}
                alt=""
                class="h-8 w-8 rounded-full bg-white p-1.5 ring-2 ring-indigo-950"
              />
            ))
          }
        </div>
        <span class="text-xs font-medium text-white/80">
          +{communityCount - communityFaces.length} more
        </span>
      </div>
      <h2 class="mt-4 text-2xl font-semibold tracking-tight">
        You don't have to geek out alone.
      </h2>
      <p class="mt-2 max-w-sm text-sm text-white/80">
        Explore {communityCount} online communities where faith and tech meet, from
        AI to church IT to game dev.
      </p>
      <span
        class="mt-4 inline-flex items-center gap-1 text-sm font-medium underline-offset-4 group-hover:underline"
      >
        Find a community <span aria-hidden="true">&rarr;</span>
      </span>
    </a>
    <hr class="dark:border-zinc-700" />
    <h2 class="text-lg font-medium">Posts</h2>
    <ul class="flex flex-col gap-1.5">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/posts/${post.slug}`}
              class="group flex justify-between gap-3"
              transition:name={post.data.title}
            >
              <span class="group-hover:underline">{post.data.title}</span>
              <span class="text-nowrap text-zinc-500">
                {formatDate(post.data.date)}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>

<style>
  .mesh-night {
    background-color: #1e1b4b;
    background-image: radial-gradient(at 15% 20%, #7c3aed 0px, transparent 50%),
      radial-gradient(at 85% 10%, #db2777 0px, transparent 45%),
      radial-gradient(at 70% 90%, #0d9488 0px, transparent 50%),
      radial-gradient(at 10% 95%, #2563eb 0px, transparent 45%);
  }
</style>
