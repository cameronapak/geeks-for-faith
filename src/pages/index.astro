---
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  className="flex h-svh max-w-sm flex-col justify-start"
>
  <main class="space-y-4">
    <h1 class="text-2xl font-medium">Geeks for Faith</h1>
    <p>
      Domain name inspired by Pat Gelsinger when he said, we are "geeks for
      faith".
    </p>
    <p>
      May this be a place where we can share our faith, our tech, and learn from
      one another.
    </p>
  </main>
</Layout>
