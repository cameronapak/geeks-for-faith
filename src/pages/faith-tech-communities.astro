---
import ExternalLink from "../components/icons/ExternalLink.astro";
import Layout from "../layouts/Layout.astro";
import { FAITH_TECH_COMMUNITIES } from "../lib/utils";
---

<Layout
  title="Online Faith & Tech Communities"
  description="A list of online faith and tech communities"
>
  <h1 class="text-2xl font-medium">Online Faith & Tech Communities</h1>
  <p class="mt-4 text-zinc-500">
    Let's be honest. There isn't a single online group fit for everyone in faith
    and tech. I've compiled a list of some of the ones I know about. If you know
    of any others, please let me know.
  </p>
  <ul class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      FAITH_TECH_COMMUNITIES.map((community) => (
        <li class="h-full w-full">
          <a
            target="_blank"
            class="relative block h-full w-full rounded-lg border p-6 shadow-none transition-shadow duration-300 hover:shadow-md"
            href={community.url}
            title={`Visit ${community.name}`}
          >
            <ExternalLink className="absolute right-2 top-2 h-4 w-4 opacity-20" />
            <div class="flex items-baseline gap-2">
              <img
                src={`https://www.google.com/s2/favicons?domain=${community.url}`}
                alt={`${community.name} favicon`}
                class="h-4 w-4 rounded-full bg-white"
              />
              <h2 class="text-lg font-medium leading-tight">
                {community.name}
              </h2>
            </div>
            <p class="mt-2 text-sm text-zinc-500">{community.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
