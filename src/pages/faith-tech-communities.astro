---
import Layout from "../layouts/Layout.astro";
import { FAITH_TECH_COMMUNITIES } from "../lib/utils";
---

<Layout
  title="Faith Tech Communities"
  description="A list of faith tech communities"
>
  <h1 class="text-2xl font-medium">Faith & Tech Communities</h1>
  <ul class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
    {
      FAITH_TECH_COMMUNITIES.map((community) => (
        <li class="h-full w-full">
          <a
            class="block h-full w-full rounded-lg border p-6"
            href={community.url}
          >
            <div class="flex items-baseline gap-2">
              <img
                src={`https://www.google.com/s2/favicons?domain=${community.url}`}
                alt={`${community.name} favicon`}
                class="mb-2 h-4 w-4"
              />
              <h2 class="text-lg font-medium">{community.name}</h2>
            </div>
            <p class="text-sm text-zinc-500">{community.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
